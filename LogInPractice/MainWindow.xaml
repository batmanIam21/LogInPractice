        xmlns:local="clr-namespace:LogInPractice"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button x:Name="Login_btn" Content="Login" HorizontalAlignment="Left" Margin="231,244,0,0" VerticalAlignment="Top"  Height="27" Width="316" Click="Button_Click"/>
        <TextBox x:Name="Password_txt" HorizontalAlignment="Left" Height="30" Margin="281,129,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="297"/>
        <TextBox x:Name="User_txt" HorizontalAlignment="Left" Height="32" Margin="281,69,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="297" />
        <Label Content="User ID" HorizontalAlignment="Left" Height="30" Margin="202,70,0,0" VerticalAlignment="Top" Width="58"/>
        <Label Content="Password" HorizontalAlignment="Left" Height="30" Margin="202,129,0,0" VerticalAlignment="Top" Width="74"/>

    </Grid>
</Window>
